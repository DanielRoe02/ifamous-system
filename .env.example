DB_TIMEZONE=Z
# Frontend / Vite
VITE_API_URL=http://localhost:3000

# For deployed frontend, use your Render backend URL:
# VITE_API_URL=https://your-render-backend.onrender.com

# Frontend URL used by email action buttons
APP_BASE_URL=http://localhost:5173

# Real outbound email (SMTP). No files are attached to messages.
# Either set SMTP_URL, or set SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
SMTP_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="I-FAMOUS <your-email@example.com>"
SMTP_POOL=true
