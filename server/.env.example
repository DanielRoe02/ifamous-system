# =========================
# I-FAMOUS Backend Environment Example
# Copy this file to server/.env for local development.
# Do not commit your real server/.env.
# =========================

DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=13207
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=ifamous_dbms
DB_SSL=true

JWT_SECRET=change_this_jwt_secret
SECRET_PEPPER=change_this_secret_pepper

OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
OLLAMA_VISION_MODEL=gemma4:31b-cloud
